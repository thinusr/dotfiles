# i3wm Configuration File

# General Settings
# ----------------

# Key Definitions
# ----------------
# $mod = Set below
# Mod4 = Super key (Windows key)
# Mod1 = ALT key
# Control = CTRL key
# Shift = SHIFT key
# Escape = ESCAPE key
# Return = ENTER or RETURN key
# KP_Enter = Keypad Enter
# Pause = PAUSE key
# Print = PRINT key
# Tab = TAB key

# Set Variables
# ----------------
set $mod Mod4
set $firstMonitor HDMI-2
set $secondMonitor eDP-1

# Appearance
# ----------
font pango:MesloLGS NF 10
exec_always --no-startup-id env GTK_THEME=Gruvbox-Dark

# Display and Monitor Configuration
# ----------------------------------
exec --no-startup-id xrandr --output eDP-1 --below HDMI-2 --auto

# Workspace Configuration
# -----------------------

# Workspace Variables
# ------------------------------
set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"
set $ws11 "11"
set $ws12 "12"
set $ws13 "13"
set $ws14 "14"
set $ws15 "15"
set $ws16 "16"
set $ws17 "17"
set $ws18 "18"
set $ws19 "19"
set $ws20 "20"

# Workspace Definitions and Assignment
# ------------------------------------
workspace 1 output $firstMonitor
workspace 2 output $firstMonitor
workspace 3 output $firstMonitor
workspace 4 output $firstMonitor
workspace 5 output $firstMonitor
workspace 6 output $firstMonitor
workspace 7 output $firstMonitor
workspace 8 output $firstMonitor
workspace 9 output $firstMonitor
workspace 10 output $firstMonitor
workspace 11 output $secondMonitor 
workspace 12 output $secondMonitor
workspace 13 output $secondMonitor
workspace 14 output $secondMonitor
workspace 15 output $secondMonitor
workspace 16 output $secondMonitor
workspace 17 output $secondMonitor
workspace 18 output $secondMonitor
workspace 19 output $secondMonitor
workspace 20 output $secondMonitor

# Workspace Navigation
# --------------------

# Switch to workspace
# -------------------
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10
bindsym $mod+mod2+KP_1 workspace $ws11
bindsym $mod+mod2+KP_2 workspace $ws12
bindsym $mod+mod2+KP_3 workspace $ws13
bindsym $mod+mod2+KP_4 workspace $ws14
bindsym $mod+mod2+KP_5 workspace $ws15
bindsym $mod+mod2+KP_6 workspace $ws16
bindsym $mod+mod2+KP_7 workspace $ws17
bindsym $mod+mod2+KP_8 workspace $ws18
bindsym $mod+mod2+KP_9 workspace $ws19
bindsym $mod+mod2+KP_0 workspace $ws20

# Move Focused Container to Workspace
# -------------------------------------
bindsym $mod+Shift+1 move container to workspace $ws1; workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2; workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3; workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4; workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5; workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6; workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7; workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8; workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9; workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10; workspace $ws10
bindsym $mod+Shift+KP_End move container to workspace $ws11; workspace $ws11
bindsym $mod+Shift+KP_Down move container to workspace $ws12; workspace $ws12
bindsym $mod+Shift+KP_Page_Down move container to workspace $ws13; workspace $ws13
bindsym $mod+Shift+KP_Left move container to workspace $ws14; workspace $ws14
bindsym $mod+Shift+KP_Begin move container to workspace $ws15; workspace $ws15
bindsym $mod+Shift+KP_Right move container to workspace $ws16; workspace $ws16
bindsym $mod+Shift+KP_Home move container to workspace $ws17; workspace $ws17
bindsym $mod+Shift+KP_Up move container to workspace $ws18; workspace $ws18
bindsym $mod+Shift+KP_Page_Up move container to workspace $ws19; workspace $ws19
bindsym $mod+Shift+KP_Insert move container to workspace $ws20; workspace $ws20

# Advanced Workspace Navigation
# -----------------------------
bindsym Mod1+Tab workspace next
bindsym Mod1+Shift+Tab workspace prev
bindsym $mod+Tab workspace back_and_forth
bindsym Mod1+Ctrl+Right workspace next
bindsym Mod1+Ctrl+Left workspace prev
for_window [urgent=latest] focus

# Application Management
# ----------------------

# Menu Launchers
# --------------
bindsym $mod+space exec --no-startup-id rofi -show drun -font "MesloLGS NF 10"
bindsym $mod+slash exec --no-startup-id rofi -show window "MesloLGS NF 10"

# Application Shortcuts
# --------------------
#bindsym $mod+l exec --no-startup-id /home/thinus/.local/share/LightBurn/LightBurn;focus
bindsym $mod+F6 exec --no-startup-id vlc;focus
bindsym $mod+equal exec --no-startup-id galculator
bindsym $mod+z exec zathura
bindsym $mod+r exec --no-startup-id kitty -e ranger

# Take a Screenshot
# ----------------
bindsym $mod+Print exec --no-startup-id flameshot gui

# Window Management
# -----------------

# Kill Window
# -----------
bindsym $mod+q kill

# Change Focus
# ------------

# Vim Motions
# -----------
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Cursor Keys
# -------------
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Moving Focused Windows
# ----------------------

# Vim Motions
# -----------
#bindsym $mod+Shift+h move left
#bindsym $mod+Shift+j move down
#bindsym $mod+Shift+k move up
#bindsym $mod+Shift+l move right

# Alternatively - Cursor Keys
# -----------------------------
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Window Layout
# -------------

# Split Windows Vertical
# ----------------------
bindsym $mod+v split v

# Split Windows Horizontal
# ----------------------
#bindsym $mod+h split h

# Toggle Full Screen
# -----------------
bindsym $mod+f fullscreen toggle

# Focus Parent Container
# ----------------------
bindsym $mod+a focus parent

# Window Resizing
# ---------------

# Resizing by 5px or 5ppt
# -----------------------
bindsym $mod+Mod1+Ctrl+Right resize shrink width 5 px or 5 ppt
bindsym $mod+Mod1+Ctrl+Up resize grow height 5 px or 5 ppt
bindsym $mod+Mod1+Ctrl+Down resize shrink height 5 px or 5 ppt
bindsym $mod+Mod1+Ctrl+Left resize grow width 5 px or 5 ppt

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle
floating_modifier $mod

# System Control
# --------------

# Power Management
# ----------------

# Log out screen - Powermenu
# -----------------------------
bindsym $mod+Shift+e exec --no-startup-id ~/.config/i3/scripts/powermenu

# Sleep Mode
# ----------
bindsym $mod+Mod1t+s exec --no-startup-id systemctl suspend

# Hibernation
# -----------
bindsym $mod+Mod1+h exec --no-startup-id systemctl hibernate

# Lock Screen
#------------
bindsym $mod+Shift+l exec --no-startup-id ~/.config/i3/scripts/lock.sh

# Screensaver
# -----------
# Start a screensaver
bindsym $mod+x exec --no-startup-id ~/scripts/cmatrix/cmatrix.sh
# Kill the screensaver
bindsym $mod+Shift+x exec --no-startup-id ~/scripts/cmatrix/kill-cmatrix.sh


# Restart and Reload
# ------------------

# Restart i3
# -----------
bindsym $mod+Shift+r restart

# Reload Configuration File
# -------------------------
bindsym $mod+Shift+c reload

# Autostart Applications
# ----------------------

# Core Services
# -------------
# Autotiling
exec_always --no-startup-id autotiling
# Start Dunst
exec --no-startup-id /usr/bin/dunst
# Start Picom
exec --no-startup-id picom --config ~/.config/picom/picom.conf
# Num Lock Activated
exec_always --no-startup-id numlockx on
# Authentication dialog
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
# Start Polybar
#exec_always --no-startup-id ~/.config/polybar/launch.sh
exec_always --no-startup-id sh -c "sleep 2 && ~/.config/polybar/launch.sh"
# Start xscreensaver
exec_always --no-startup-id xscreensaver -nosplash

# Tray Applications
# -----------------
# bluetooth
exec --no-startup-id blueberry-tray
# network
exec --no-startup-id nm-applet

# Optional Services
# -----------------
# Start Dropbox
exec --no-startup-id dropbox start -i
# Restore Wallpaper
exec --no-startup-id nitrogen --restore
# Rotate wallpaper
#exec_always --no-startup-id feh --randomize --bg-fill /home/thinus/Pictures/.wallpaper/wallpaper/vehicles/*

# Start Onedrive
exec --no-startup-id onedrive --monitor
# Start pcloud
exec --no-startup-id /home/thinus/applications/pcloud

